spring:
  datasource:
    url: jdbc:mysql://${COMPUTE_MYSQL_HOST:127.0.0.1}:${COMPUTE_MYSQL_PORT:3306}/bemodel_compute_platform?createDatabaseIfNotExist=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
    username: ${COMPUTE_MYSQL_USERNAME}
    password: ${COMPUTE_MYSQL_PASSWORD}
  flyway:
    locations: classpath:db/compute-platform
    # 重启只执行未应用过的版本化迁移；禁止自动清理已有业务库。
    clean-disabled: true
    validate-on-migrate: true

# Business database is independent from the primary platform pool/transaction manager.
# Empty URL/credentials inherit the resolved platform endpoint/credentials with schema a800_compute.
compute:
  datasource:
    jdbc-url: ${COMPUTE_BUSINESS_JDBC_URL:}
    username: ${COMPUTE_BUSINESS_USERNAME:}
    password: ${COMPUTE_BUSINESS_PASSWORD:}
    maximum-pool-size: 4
    minimum-idle: 1
  runtime:
    # REAL 在 N-16 真实采集与执行适配器接入前会拒绝启动。
    mode: ${COMPUTE_RUNTIME_MODE:SIMULATION}
    # 固定教学样例只插入一次；模拟器使用独立的 A800_SIMULATOR_V1 观测来源。
    demo-dataset: ${COMPUTE_DEMO_DATASET:A800_DEMO_FIXTURE}
    # 算力模式默认不提供医疗专用控制器、定时任务和 MCP 工具；跨域联调时才显式打开。
    medical-apis-enabled: ${COMPUTE_MEDICAL_APIS_ENABLED:false}
  simulator:
    # 默认关闭；开启后仍须通过管理员接口显式初始化节点，不会在启动时刷新观测或执行动作。
    enabled: ${COMPUTE_SIMULATOR_ENABLED:false}
  queue:
    # 队列自动重评默认关闭；资源变化事件仍可在同进程内触发一次重评。
    recheck-enabled: ${COMPUTE_QUEUE_RECHECK_ENABLED:false}
    recheck-delay-ms: 30000

bemodel:
  inspect:
    cron: "-"
  reconcile:
    cron: "-"
  proposal:
    cron: "-"
  semantic:
    scene-ds: A800_COMPUTE
