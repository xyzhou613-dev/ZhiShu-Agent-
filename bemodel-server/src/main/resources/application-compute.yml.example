spring:
  datasource:
    url: jdbc:mysql://${COMPUTE_MYSQL_HOST:127.0.0.1}:${COMPUTE_MYSQL_PORT:3306}/bemodel_compute_platform?createDatabaseIfNotExist=true&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
    username: ${COMPUTE_MYSQL_USERNAME}
    password: ${COMPUTE_MYSQL_PASSWORD}
  flyway:
    locations: classpath:db/compute-platform

bemodel:
  inspect:
    cron: "-"
  reconcile:
    cron: "-"
  proposal:
    cron: "-"
  semantic:
    scene-ds: A800_COMPUTE
